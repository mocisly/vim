+    static PyObject *
+VimRuntimeNames(PyObject *module, int public_only)
+{
+    static const char *dynamic_names[] = {"vars", "vvars", "options"};
+    PyObject *dict = PyModule_GetDict(module);
+    PyObject *names = PyList_New(0);
+    PyObject *key;
+    PyObject *value;
+    Py_ssize_t pos = 0;
+    unsigned int i;
+
+    if (names == NULL)
+	return NULL;
+    while (PyDict_Next(dict, &pos, &key, &value))
+    {
+	if (public_only)
+	{
+	    PyObject *bytes = PyUnicode_AsEncodedString(key, "utf-8", "strict");
+	    int private_name;
+	    if (bytes == NULL)
+		goto fail;
+	    private_name = PyBytes_AsString(bytes)[0] == '_';
+	    Py_DECREF(bytes);
+	    if (private_name)
+		continue;
+	}
+	if (PyList_Append(names, key))
+	    goto fail;
+    }
+    for (i = 0; i < sizeof(dynamic_names) / sizeof(dynamic_names[0]); ++i)
+    {
+	PyObject *name;
+	int result;
+	if (PyDict_GetItemString(dict, dynamic_names[i]) != NULL)
+	    continue;
+	name = PyString_FromString(dynamic_names[i]);
+	if (name == NULL)
+	    goto fail;
+	result = PyList_Append(names, name);
+	Py_DECREF(name);
+	if (result)
+	    goto fail;
+    }
+    return names;
+
+fail:
+    Py_DECREF(names);
+    return NULL;
+}
