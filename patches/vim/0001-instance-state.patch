+    bytes = PyUnicode_AsEncodedString(nameObject, "utf-8", "strict");
+    if (bytes == NULL)
+        return NULL;
+    name = PyBytes_AsString(bytes);
+    if (strcmp(name, "vars") == 0)
+        result = NEW_DICTIONARY(get_globvar_dict());
+    else if (strcmp(name, "vvars") == 0)
+        result = NEW_DICTIONARY(get_vimvar_dict());
