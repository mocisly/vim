+/*
+ * CPython and its module cache are process-wide.  A module can retain a Vim
+ * wrapper after its worker exits, or drop its last reference on another
+ * worker.  Keep the Python allocation separate from its Vim resources: only
+ * the owning worker may access/release those resources.  All registry access
+ * is protected by the GIL.  Entries do not own live Python references, except
+ * for a deferred deallocation which is drained on the owner before shutdown.
+ */
+typedef struct py_runtime_ref_S {
+    struct py_runtime_ref_S *next;
+    PyObject *object;
+    void (*release)(PyObject *);
+    void (*relocate)(PyObject *, PyObject *);
+    size_t snapshot_size;
+    unsigned long long owner;
+    int released;
+    int deferred;
+    int detached;
+} py_runtime_ref_T;
+
+static py_runtime_ref_T *python_runtime_refs;
+static VIM_INSTANCE_TLS int python_runtime_call_depth;
+static VIM_INSTANCE_TLS int python_runtime_exit_requested;
+static VIM_INSTANCE_TLS int python_runtime_exit_code;
+static VIM_INSTANCE_TLS int python_runtime_exit_in_progress;
+static VIM_INSTANCE_TLS int python_runtime_closing;
+
+    static py_runtime_ref_T *
+PythonRuntimeFind(PyObject *object)
+{
+    py_runtime_ref_T *ref;
+
+    if (object == NULL)
+	return NULL;
+    for (ref = python_runtime_refs; ref != NULL; ref = ref->next)
+	if (ref->object == object)
+	    return ref;
+    return NULL;
+}
+
+    static int
+PythonRuntimeCheck(PyObject *object)
+{
+    unsigned long long owner = vim_runtime_thread_serial();
+    py_runtime_ref_T *ref = PythonRuntimeFind(object);
+
+    if (python_runtime_closing)
+    {
+	PyErr_SetString(PyExc_RuntimeError, "Vim instance is closing");
+	return -1;
+    }
+    if (python_runtime_exit_requested)
+    {
+	PyErr_SetNone(PyExc_SystemExit);
+	return -1;
+    }
+    if (owner == 0)
+    {
+	PyErr_SetString(PyExc_RuntimeError,
+		"Vim objects must be used on a Vim instance worker");
+	return -1;
+    }
+    if (ref != NULL && (ref->released || ref->owner != owner))
+    {
+	PyErr_SetString(PyExc_RuntimeError, ref->released
+		? "Vim object belongs to a closed instance"
+		: "Vim object belongs to another instance");
+	return -1;
+    }
+    return 0;
+}
+
+    static int
+PythonRuntimeRegisterValue(PyObject *object, void (*release)(PyObject *),
+	size_t snapshot_size, void (*relocate)(PyObject *, PyObject *))
+{
+    py_runtime_ref_T *ref = PyMem_Malloc(sizeof(*ref) + snapshot_size);
+
+    if (ref == NULL)
+    {
+	PyErr_NoMemory();
+	return -1;
+    }
+    ref->object = object;
+    ref->release = release;
+    ref->relocate = relocate;
+    ref->snapshot_size = snapshot_size;
+    ref->owner = vim_runtime_thread_serial();
+    ref->released = FALSE;
+    ref->deferred = FALSE;
+    ref->detached = FALSE;
+    ref->next = python_runtime_refs;
+    python_runtime_refs = ref;
+    return 0;
+}
+
+# define PythonRuntimeRegister(object, release) \
+    PythonRuntimeRegisterValue(object, release, 0, NULL)
+
+/* Return TRUE when deallocation is deferred and the Python object stays alive. */
+    static int
+PythonRuntimeDealloc(PyObject *object, void (*release)(PyObject *))
+{
+    py_runtime_ref_T **link;
+    py_runtime_ref_T *ref;
+
+    for (link = &python_runtime_refs; (ref = *link) != NULL;
+	    link = &ref->next)
+	if (ref->object == object)
+	    break;
+    if (ref == NULL)
+    {
+	if (release != NULL)
+	    release(object);
+	return FALSE;
+    }
+    if (!ref->released && ref->owner != vim_runtime_thread_serial())
+    {
+	if (ref->relocate != NULL)
+	{
+	    // Subclass deallocators must be allowed to finish normally.  Move
+	    // only the base wrapper's Vim references into preallocated storage,
+	    // keeping their GC roots linked until the owning worker releases
+	    // them.  No Python APIs are called on this resource-only snapshot.
+	    PyObject *snapshot = (PyObject *)(ref + 1);
+	    mch_memmove(snapshot, object, ref->snapshot_size);
+	    ref->relocate(object, snapshot);
+	    ref->object = snapshot;
+	    ref->detached = TRUE;
+	    ref->deferred = TRUE;
+	    return FALSE;
+	}
+	// tp_dealloc has not freed anything yet.  This reference belongs to the
+	// pending queue until the owner next executes Python or closes.  Only
+	// non-subclassable types use this path.
+	Py_INCREF(object);
+	ref->deferred = TRUE;
+	return TRUE;
+    }
+    *link = ref->next;
+    if (!ref->released && release != NULL)
+	release(object);
+    PyMem_Free(ref);
+    return FALSE;
+}
+
+    static void
+PythonRuntimeDrain(void)
+{
+    unsigned long long owner = vim_runtime_thread_serial();
+    py_runtime_ref_T *ref;
+    py_runtime_ref_T **link;
+
+    // Destruction can remove other entries, so restart after each decref.
+    for (;;)
+    {
+	for (link = &python_runtime_refs; (ref = *link) != NULL;
+		link = &ref->next)
+	    if (ref->owner == owner && ref->deferred)
+		break;
+	if (ref == NULL)
+	    break;
+	ref->deferred = FALSE;
+	if (ref->detached)
+	{
+	    *link = ref->next;
+	    ref->release(ref->object);
+	    PyMem_Free(ref);
+	}
+	else
+	    Py_DECREF(ref->object);
+    }
+}
+
+    static void
+PythonRuntimeShutdown(void)
+{
+    unsigned long long owner = vim_runtime_thread_serial();
+    py_runtime_ref_T *ref;
+
+    PythonRuntimeDrain();
+    for (;;)
+    {
+	for (ref = python_runtime_refs; ref != NULL; ref = ref->next)
+	    if (ref->owner == owner && !ref->released)
+		break;
+	if (ref == NULL)
+	    break;
+	ref->released = TRUE;
+	if (ref->release != NULL)
+	    ref->release(ref->object);
+    }
+}
+#else
+# define PythonRuntimeCheck(object) 0
+# define PythonRuntimeRegister(object, release) 0
+# define PythonRuntimeRegisterValue(object, release, size, relocate) 0
+    static int
+PythonRuntimeDealloc(PyObject *object, void (*release)(PyObject *))
+{
+    if (release != NULL)
+	release(object);
+    return FALSE;
+}
+#endif
