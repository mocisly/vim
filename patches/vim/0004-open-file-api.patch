  * To be called when text is unlocked, curbuf is unlocked or updating_screen is
  * reset: Handle a postponed drop.
  */
+#ifdef VIM_RUNTIME_LIBRARY
+/* Queue one exact filename through Vim's safe drop path.  If a native drop is
+ * already active or postponed, leave the host request pending for a later
+ * GUI loop iteration.  Ownership transfers only on return value 1. */
+    int
+vim_runtime_handle_drop_one(char_u *path, void (*callback)(void *), void *cookie)
+{
+    char_u **files;
+
+    if (drop_busy || drop_filev != NULL)
+        return 0;
+    files = ALLOC_MULT(char_u *, 1);
+    if (files == NULL)
+        return -1;
+    files[0] = path;
+    handle_drop(1, files, FALSE, callback, cookie);
+    return 1;
+}
+#endif
