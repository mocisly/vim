{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-qt",
      "displayName": "VS2026 x64 with Qt 6.12",
