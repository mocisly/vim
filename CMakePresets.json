      "cacheVariables": {
        "VIM_ENABLE_QT_HOST": "ON",
        "VIM_BUILD_SHARED_CORE": "ON",
        "CMAKE_PREFIX_PATH": "C:/Programs/Qt/6.12.0/msvc2022_64"
      }
    }
  ]
}
